1 24 "setup.manifest"
1 ICON "../host/res/app.ico"
101 RCDATA "../dist/tdisplay-host.exe"
102 RCDATA "../dist/TDisplay.apk"
103 RCDATA "../dist/adb/adb.exe"
104 RCDATA "../dist/adb/AdbWinApi.dll"
105 RCDATA "../dist/adb/AdbWinUsbApi.dll"
106 RCDATA "../driver/package/VirtualDisplayDriver/MttVDD.dll"
107 RCDATA "../driver/package/VirtualDisplayDriver/MttVDD.inf"
108 RCDATA "../driver/package/VirtualDisplayDriver/mttvdd.cat"
109 RCDATA "../driver/vdd_settings.xml"
110 RCDATA "Getting started.txt"
111 RCDATA "Virtual Display Driver license.txt"
112 RCDATA "../tools/android-sdk/platform-tools/NOTICE.txt"

#include "version.h"

// Shown in Properties > Details. TD_VERSION and the rest come from build\version.h, written by scripts\build.ps1.
1 VERSIONINFO
FILEVERSION TD_VERSION
PRODUCTVERSION TD_VERSION
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TDisplay"
            VALUE "FileDescription", "TDisplay Setup"
            VALUE "FileVersion", TD_VERSION_TEXT
            VALUE "InternalName", "TDisplaySetup"
            VALUE "LegalCopyright", TD_COPYRIGHT
            VALUE "OriginalFilename", "TDisplaySetup.exe"
            VALUE "ProductName", "TDisplay"
            VALUE "ProductVersion", TD_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
